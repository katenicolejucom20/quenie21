    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Pre-connects to Google's font file server too; crossorigin allows cross-origin font loading -->
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Dancing+Script:wght@700&display=swap"
        rel="stylesheet" />
    <!-- Loads two Google Fonts: "Poppins" (for body text) and "Dancing Script" (for fancy cursive titles) -->
    <link rel="stylesheet" href="style.css" /> <!-- Links to our custom CSS file that styles the entire page -->
